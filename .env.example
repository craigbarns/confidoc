# ==============================================================================
# ConfiDoc Backend — Environment Variables
# ==============================================================================
# Copier ce fichier en .env et adapter les valeurs

# ---- Application ----
APP_NAME=ConfiDoc
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-openssl-rand-hex-64
LOG_LEVEL=DEBUG

# ---- API ----
API_V1_PREFIX=/api/v1
# CORS : pour l’UI servie sur le même domaine que l’API (/ui → /api), souvent suffisant tel quel.
# Ajoutez votre URL publique si vous appelez l’API depuis un autre origine (SPA local, autre sous-domaine).
# En production : uniquement le(s) domaine(s) réel(s) du front (pas *, pas localhost).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://VOTRE-APP.up.railway.app

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=confidoc
POSTGRES_PASSWORD=confidoc_dev_password
POSTGRES_DB=confidoc
DATABASE_URL=postgresql+asyncpg://confidoc:confidoc_dev_password@localhost:5432/confidoc

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- MinIO / S3 Storage ----
# Production: utiliser minio/S3 ou database, jamais local éphémère.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/tmp/confidoc_uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=confidoc_minio
MINIO_SECRET_KEY=confidoc_minio_secret
MINIO_BUCKET=confidoc-documents
MINIO_USE_SSL=false

# ---- Anonymization Governance ----
# Dictionnaires client hors repo. Format JSON:
# {"replacement_rules":[["(?i)ACME","[SOCIETE_1]",false]],
#  "partial_replacements":[],"post_cleanup_rules":[]}
ANONYMIZATION_RULES_PATH=

# ---- JWT ----
JWT_SECRET_KEY=CHANGE-ME-USE-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Encryption ----
ENCRYPTION_MASTER_KEY=CHANGE-ME-USE-python-c-from-cryptography.fernet-import-Fernet;print(Fernet.generate_key().decode())

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# ---- Structured Extraction Thresholds (optionnel) ----
# Décommentez uniquement si vous voulez surcharger les valeurs par défaut.
# EXTRACT_AMOUNT_MIN_DEFAULT=100
# EXTRACT_AMOUNT_MIN_LOW=50
# EXTRACT_AMOUNT_ABS_HARD_CAP=5000000
# EXTRACT_COMPONENT_ABS_HARD_CAP=10000000
# EXTRACT_COMPONENT_VS_PASSIF_RATIO_CAP=1.2
# EXTRACT_QUALITY_READY_COVERAGE_MIN=0.8
# EXTRACT_QUALITY_READY_CONSISTENCY_MIN=0.85
# EXTRACT_QUALITY_CORE_NUMERIC_MIN=0.85
# EXTRACT_QUALITY_CORE_AGGREGATE_MIN=0.85
# EXTRACT_AGGREGATE_REL_TOLERANCE=0.03
# EXTRACT_AGGREGATE_ABS_TOLERANCE_MIN=2.0
