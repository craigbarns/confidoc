# ==============================================================================
# ConfiDoc Backend — Celery Worker Dockerfile
# This image ONLY runs the Celery worker. It does NOT start Uvicorn or FastAPI.
# Railway must use this file via railway.worker.toml (builder = "dockerfile").
# ==============================================================================
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libgl1-mesa-glx \
    tesseract-ocr \
    tesseract-ocr-fra \
    tesseract-ocr-eng \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels ".[processing]"


# ==============================================================================
# Phase finale (Worker avec OCR)
# ==============================================================================
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Explicit marker: this container is a Celery worker, not the API.
# Railpack / Railway must never override this with uvicorn.
ENV CELERY_WORKER=true
ENV PORT=""

WORKDIR /app

# Dépendances système lourdes pour OCR et parsing PDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    tesseract-ocr \
    tesseract-ocr-fra \
    tesseract-ocr-eng \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

COPY . .

# Télécharger le modèle spaCy de base (NER FR) - Optionnel mais recommandé ici
RUN python -m spacy download fr_core_news_md

COPY docker/entrypoint-worker.sh /entrypoint-worker.sh
RUN chmod +x /entrypoint-worker.sh

RUN useradd -m confidoc && chown -R confidoc:confidoc /app
USER confidoc

# ENTRYPOINT (not CMD) ensures Railway/Railpack cannot override the command.
# The worker runs Celery exclusively — Uvicorn is never started here.
ENTRYPOINT ["/entrypoint-worker.sh"]
